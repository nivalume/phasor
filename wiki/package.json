{
  "name": "phasor-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "phasor knowledge base: Markdown pages in content/ plus a React viewer with a graph of how pages relate.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-wiki.mjs",
    "check:mermaid": "python3 ../skills/mermaid-diagrams/scripts/check_mermaid.py content",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.1.0",
    "@fontsource/space-mono": "5.1.0",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "github-slugger": "2.0.0",
    "mermaid": "11.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.0",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.1.6",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.8",
    "@types/hast": "3.0.5",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
